<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace />
    <IsPackable>False</IsPackable>
    <NoWarn>CS0649;CS0169</NoWarn>
    <FalloutRootDirectory>..</FalloutRootDirectory>
    <FalloutScriptDirectory>..</FalloutScriptDirectory>
    <FalloutTelemetryVersion>1</FalloutTelemetryVersion>
  </PropertyGroup>
  <ItemGroup>
    <FalloutMetadata Include="**/*.json" Exclude="**/bin/**;**/obj/**;LegacyCodeGeneration/**" />
    <None Remove="*.csproj.dotsettings;_schema.json;*.ref.*.txt" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fallout.Common" Version="10.5.0" />
    <PackageReference Include="Dangl.Fallout.WebDocu" Version="8.0.1" />
    <PackageReference Include="Dangl.Fallout.GitHub" Version="8.0.1" />
    <PackageDownload Include="GitVersion.Tool" Version="[5.12.0]" />
    <PackageDownload Include="docfx" Version="[2.78.5]" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="LegacyCodeGeneration/**/*.cs" />
  </ItemGroup>
</Project>
